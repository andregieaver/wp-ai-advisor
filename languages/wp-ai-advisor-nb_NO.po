#. translators: %s: comma-separated list of file extensions.
#: admin/class-wp-ai-advisor-admin.php:291
msgid "Upload price lists, menus or policies the website does not spell out. Allowed: %s. Scanned PDFs hold images rather than text and cannot be read."
msgstr "Last opp prislister, menyer eller vilkår som ikke står på nettstedet. Tillatt: %s. Skannede PDF-er inneholder bilder i stedet for tekst og kan ikke leses."

#: admin/class-wp-ai-advisor-admin.php:298
msgid "Document language"
msgstr "Dokumentspråk"

#: admin/class-wp-ai-advisor-admin.php:307
msgid "Upload and index"
msgstr "Last opp og indekser"

#: admin/class-wp-ai-advisor-admin.php:314
msgid "Title"
msgstr "Tittel"

#: admin/class-wp-ai-advisor-admin.php:315
msgid "Type"
msgstr "Type"

#: admin/class-wp-ai-advisor-admin.php:317
msgid "Status"
msgstr "Status"

#: admin/class-wp-ai-advisor-admin.php:318
msgid "Updated"
msgstr "Oppdatert"

#: admin/class-wp-ai-advisor-admin.php:325
msgid "Nothing indexed yet."
msgstr "Ingenting er indeksert ennå."

#: admin/class-wp-ai-advisor-admin.php:350
msgid "Delete"
msgstr "Slett"

#. translators: %s: comma-separated post type names.
#: admin/class-wp-ai-advisor-admin.php:377
msgid "Local mode: reads published %s from this install, with no HTTP requests. Re-run after you change content."
msgstr "Lokal modus: leser publiserte %s fra denne installasjonen, uten HTTP-forespørsler. Kjør på nytt når du endrer innhold."

#. translators: %s: comma-separated post type names.
#: admin/class-wp-ai-advisor-admin.php:378 admin/class-wp-ai-advisor-admin.php:386
msgid "(no post types selected)"
msgstr "(ingen innholdstyper er valgt)"

#. translators: 1: site URL, 2: comma-separated post type names.
#: admin/class-wp-ai-advisor-admin.php:384
msgid "Both modes: crawls %1$s for rendered navigation and reads published %2$s locally. Re-run after the site changes."
msgstr "Begge modi: gjennomsøker %1$s for ferdig vist navigasjon og leser publiserte %2$s lokalt. Kjør på nytt når nettstedet endres."

#. translators: %s: site URL being crawled.
#: admin/class-wp-ai-advisor-admin.php:392
msgid "Crawl mode: fetches %s, follows its internal links and stores the text. Re-run after the site changes."
msgstr "Gjennomsøkingsmodus: henter %s, følger interne lenker og lagrer teksten. Kjør på nytt når nettstedet endres."

#: admin/class-wp-ai-advisor-admin.php:406
msgid "Create a key at platform.openai.com. For production sites, define WP_AI_ADVISOR_API_KEY in wp-config.php instead of storing the key in the database."
msgstr "Opprett en nøkkel på platform.openai.com. På nettsteder i drift bør du definere WP_AI_ADVISOR_API_KEY i wp-config.php i stedet for å lagre nøkkelen i databasen."

#: admin/class-wp-ai-advisor-admin.php:466
msgid "is defined in wp-config.php and takes precedence over this field."
msgstr "er definert i wp-config.php og overstyrer dette feltet."

#: admin/class-wp-ai-advisor-admin.php:477
msgid "A key is saved. Enter a new key to replace it."
msgstr "En nøkkel er lagret. Skriv inn en ny nøkkel for å erstatte den."

#: admin/class-wp-ai-advisor-admin.php:480
msgid "Leave blank to keep the saved key."
msgstr "La feltet stå tomt for å beholde den lagrede nøkkelen."

#: admin/class-wp-ai-advisor-admin.php:490
msgid "Any chat model your account can use, for example gpt-4o-mini or gpt-4o."
msgstr "Enhver chat-modell kontoen din har tilgang til, for eksempel gpt-4o-mini eller gpt-4o."

#: admin/class-wp-ai-advisor-admin.php:500
msgid "Changing this invalidates the stored vectors — re-crawl afterwards."
msgstr "Endrer du denne, blir de lagrede vektorene ugyldige — bygg kunnskapsbasen på nytt etterpå."

#: admin/class-wp-ai-advisor-admin.php:510
msgid "Lower is more literal. 0.2 suits factual answers."
msgstr "Lavere verdi gir mer bokstavelige svar. 0,2 passer for faktasvar."

#: admin/class-wp-ai-advisor-admin.php:532
msgid "Crawl the site over HTTP"
msgstr "Gjennomsøk nettstedet over HTTP"

#: admin/class-wp-ai-advisor-admin.php:533
msgid "Sees the site exactly as a visitor does, including rendered navigation. Needs the site to be reachable from the server."
msgstr "Ser nettstedet nøyaktig slik en besøkende gjør, inkludert ferdig vist navigasjon. Krever at nettstedet er tilgjengelig fra serveren."

#: admin/class-wp-ai-advisor-admin.php:536
msgid "Read posts from this WordPress install"
msgstr "Les innlegg fra denne WordPress-installasjonen"

#: admin/class-wp-ai-advisor-admin.php:537
msgid "No HTTP requests and no page limit. Reaches unlinked pages a crawl would never find, but sees only post content, not theme-rendered menus."
msgstr "Ingen HTTP-forespørsler og ingen sidegrense. Finner sider uten lenker som en gjennomsøking aldri ville funnet, men ser bare innholdet i innlegg, ikke menyer som temaet genererer."

#: admin/class-wp-ai-advisor-admin.php:540
msgid "Both"
msgstr "Begge"

#: admin/class-wp-ai-advisor-admin.php:541
msgid "Crawl for navigation, local posts for completeness. Pages covered twice cost extra tokens to index and may return near-duplicate passages."
msgstr "Gjennomsøking for navigasjon, lokale innlegg for fullstendighet. Sider som dekkes to ganger koster ekstra tokens å indeksere og kan gi nesten like utdrag."

#: admin/class-wp-ai-advisor-admin.php:588
msgid "Only used in local mode. Published posts only; drafts, private and password-protected posts are skipped."
msgstr "Brukes bare i lokal modus. Kun publiserte innlegg; utkast, private og passordbeskyttede innlegg hoppes over."

#: admin/class-wp-ai-advisor-admin.php:598
msgid "Leave blank to crawl this site. Only used in crawl mode."
msgstr "La feltet stå tomt for å gjennomsøke dette nettstedet. Brukes bare i gjennomsøkingsmodus."

#: admin/class-wp-ai-advisor-admin.php:608
msgid "Caps how many pages a crawl fetches. Each page costs an embedding call."
msgstr "Begrenser hvor mange sider en gjennomsøking henter. Hver side koster et embedding-kall."

#: admin/class-wp-ai-advisor-admin.php:623
msgid "One fragment per line. Any URL containing one is skipped."
msgstr "Én tekstbit per linje. Alle nettadresser som inneholder en av dem, hoppes over."

#: admin/class-wp-ai-advisor-admin.php:636
msgid "Only answer from indexed site content and uploaded documents."
msgstr "Svar kun ut fra indeksert innhold fra nettstedet og opplastede dokumenter."

#: admin/class-wp-ai-advisor-admin.php:639
msgid "With this off, the model may also answer from general knowledge."
msgstr "Er denne slått av, kan modellen også svare ut fra generell kunnskap."

#: admin/class-wp-ai-advisor-admin.php:654
msgid "Shown when a question is outside the knowledge base. Leave blank for the default."
msgstr "Vises når et spørsmål faller utenfor kunnskapsbasen. La feltet stå tomt for standardteksten."

#: admin/class-wp-ai-advisor-admin.php:669
msgid "Sets tone and role. Grounding rules are appended automatically. Leave blank for the default."
msgstr "Angir tone og rolle. Regler for forankring legges til automatisk. La feltet stå tomt for standardteksten."

#: admin/class-wp-ai-advisor-admin.php:679
msgid "How many matching passages are sent with each question."
msgstr "Hvor mange treff som sendes med hvert spørsmål."

#: admin/class-wp-ai-advisor-admin.php:689
msgid "Passages scoring below this are ignored. Raise it if answers drift, lower it if the advisor refuses too often."
msgstr "Utdrag med lavere poengsum ignoreres. Øk verdien hvis svarene sklir ut, senk den hvis rådgiveren avviser for ofte."

#: admin/class-wp-ai-advisor-admin.php:701
msgid "Match the visitor (recommended)"
msgstr "Følg den besøkende (anbefalt)"

#: admin/class-wp-ai-advisor-admin.php:702
msgid "Always use the language of the page"
msgstr "Bruk alltid språket på siden"

#. translators: 1: language name, 2: language code.
#: admin/class-wp-ai-advisor-admin.php:707
msgid "Always %1$s (%2$s)"
msgstr "Alltid %1$s (%2$s)"

#. translators: %s: language name of the WordPress install.
#: admin/class-wp-ai-advisor-admin.php:726
msgid "This site runs in %s. On a translated site the widget reports the language of the page it sits on, which is what \"match the visitor\" falls back to."
msgstr "Dette nettstedet kjører på %s. På et oversatt nettsted rapporterer modulen språket til siden den står på, og det er dette «følg den besøkende» faller tilbake på."

#: admin/class-wp-ai-advisor-admin.php:742
msgid "Show the widget to administrators only."
msgstr "Vis modulen kun for administratorer."

#: admin/class-wp-ai-advisor-admin.php:745
msgid "Use this to test on a live site: visitors see nothing and the endpoint refuses them."
msgstr "Bruk denne for å teste på et nettsted i drift: besøkende ser ingenting, og endepunktet avviser dem."

#: admin/class-wp-ai-advisor-admin.php:755
msgid "Per visitor, per hour. 0 disables the limit. Administrators are never limited."
msgstr "Per besøkende, per time. 0 slår av grensen. Administratorer begrenses aldri."

#: admin/class-wp-ai-advisor-admin.php:765
msgid "Small label above the heading, e.g. \"Ask us\"."
msgstr "Liten etikett over overskriften, for eksempel «Spør oss»."

#: admin/class-wp-ai-advisor-admin.php:798
msgid "One per line, up to six. Shown as buttons on the closed card."
msgstr "Ett per linje, opptil seks. Vises som knapper på det lukkede kortet."

#: admin/class-wp-ai-advisor-admin.php:815
msgid "Label and URL for the highlighted button under each answer, e.g. \"Book a table\". Leave blank to hide it."
msgstr "Tekst og nettadresse for den fremhevede knappen under hvert svar, for eksempel «Bestill bord». La feltene stå tomme for å skjule den."

#: includes/class-wp-ai-advisor-crawler.php:85
msgid "Not an HTML page."
msgstr "Ikke en HTML-side."

#: includes/class-wp-ai-advisor-crawler.php:97 includes/class-wp-ai-advisor-local-content.php:105
msgid "No readable text found."
msgstr "Fant ingen lesbar tekst."

#. translators: %s: comma-separated list of file extensions.
#: includes/class-wp-ai-advisor-documents.php:71
msgid "Unsupported file type. Allowed: %s."
msgstr "Filtypen støttes ikke. Tillatt: %s."

#: includes/class-wp-ai-advisor-documents.php:179
msgid "The uploaded file could not be read."
msgstr "Den opplastede filen kunne ikke leses."

#: includes/class-wp-ai-advisor-documents.php:210
msgid "No readable text could be extracted from this file. If it is a scanned PDF, run OCR on it first or paste the text into a .txt file."
msgstr "Kunne ikke hente ut lesbar tekst fra denne filen. Er det en skannet PDF, må du kjøre OCR på den først eller lime teksten inn i en .txt-fil."

#: includes/class-wp-ai-advisor-documents.php:227
msgid "Reading .docx files needs the PHP zip extension, which is not enabled on this server."
msgstr "Lesing av .docx-filer krever PHP-utvidelsen zip, som ikke er aktivert på denne serveren."

#: includes/class-wp-ai-advisor-documents.php:234
msgid "The .docx file could not be opened."
msgstr "Kunne ikke åpne .docx-filen."

#: includes/class-wp-ai-advisor-documents.php:241
msgid "The .docx file has no readable document body."
msgstr ".docx-filen har ingen lesbar dokumentdel."

#: includes/class-wp-ai-advisor-indexer.php:35
msgid "Nothing to index."
msgstr "Ingenting å indeksere."

