msgstr "Aksentfarge"

#: admin/class-wp-ai-advisor-admin.php:231
msgid "Knowledge base"
msgstr "Kunnskapsbase"

#. translators: 1: plain shortcode, 2: shortcode for a product page.
#: admin/class-wp-ai-advisor-admin.php:242
msgid "Place the advisor on any page with %1$s. On a product or post template use %2$s, and it will answer about whatever the visitor is looking at."
msgstr "Legg rådgiveren på en hvilken som helst side med %1$s. På en produkt- eller innleggsmal bruker du %2$s, så svarer den om det den besøkende ser på."

#: admin/class-wp-ai-advisor-admin.php:295 admin/class-wp-ai-advisor-admin.php:350
msgid "Sources"
msgstr "Kilder"

#: admin/class-wp-ai-advisor-admin.php:296 admin/class-wp-ai-advisor-admin.php:359
msgid "Indexed"
msgstr "Indeksert"

#: admin/class-wp-ai-advisor-admin.php:297 admin/class-wp-ai-advisor-admin.php:357
msgid "To fetch"
msgstr "Skal hentes"

#: admin/class-wp-ai-advisor-admin.php:298 admin/class-wp-ai-advisor-admin.php:358
msgid "To index"
msgstr "Skal indekseres"

#: admin/class-wp-ai-advisor-admin.php:299 admin/class-wp-ai-advisor-admin.php:356
msgid "Failed"
msgstr "Mislyktes"

#: admin/class-wp-ai-advisor-admin.php:300
msgid "Passages"
msgstr "Utdrag"

#: admin/class-wp-ai-advisor-admin.php:303
msgid "Languages"
msgstr "Språk"

#: admin/class-wp-ai-advisor-admin.php:308
msgid "Test connection"
msgstr "Test tilkoblingen"

#: admin/class-wp-ai-advisor-admin.php:309
msgid "Build knowledge base"
msgstr "Bygg kunnskapsbasen"

#: admin/class-wp-ai-advisor-admin.php:311
msgid "Crawl only"
msgstr "Kun gjennomsøking"

#: admin/class-wp-ai-advisor-admin.php:314
msgid "Import local content only"
msgstr "Kun import av lokalt innhold"

#: admin/class-wp-ai-advisor-admin.php:316
msgid "Resume"
msgstr "Fortsett"

#: admin/class-wp-ai-advisor-admin.php:318
msgid "Retry failed"
msgstr "Prøv mislykkede på nytt"

#: admin/class-wp-ai-advisor-admin.php:320
msgid "Stop"
msgstr "Stopp"

#: admin/class-wp-ai-advisor-admin.php:321
msgid "Clear everything"
msgstr "Tøm alt"

#: admin/class-wp-ai-advisor-admin.php:326
msgid "Additional documents"
msgstr "Tilleggsdokumenter"

#. translators: %s: comma-separated list of file extensions.
#: admin/class-wp-ai-advisor-admin.php:331
msgid "Upload price lists, menus or policies the website does not spell out. Allowed: %s. Scanned PDFs hold images rather than text and cannot be read."
msgstr "Last opp prislister, menyer eller vilkår som ikke står på nettstedet. Tillatt: %s. Skannede PDF-er inneholder bilder i stedet for tekst og kan ikke leses."

#: admin/class-wp-ai-advisor-admin.php:338
msgid "Document language"
msgstr "Dokumentspråk"

#: admin/class-wp-ai-advisor-admin.php:347
msgid "Upload and index"
msgstr "Last opp og indekser"

#: admin/class-wp-ai-advisor-admin.php:355
msgid "All"
msgstr "Alle"

#: admin/class-wp-ai-advisor-admin.php:360
msgid "Duplicates"
msgstr "Duplikater"

#: admin/class-wp-ai-advisor-admin.php:380
msgid "Bulk actions"
msgstr "Masseredigering"

#: admin/class-wp-ai-advisor-admin.php:381
msgid "Queue for crawling again"
msgstr "Legg i kø for ny gjennomsøking"

#: admin/class-wp-ai-advisor-admin.php:382 admin/class-wp-ai-advisor-admin.php:455
msgid "Delete"
msgstr "Slett"

#: admin/class-wp-ai-advisor-admin.php:384
msgid "Apply"
msgstr "Utfør"

#. translators: %d: number of duplicate sources.
#: admin/class-wp-ai-advisor-admin.php:391
msgid "Delete all %d duplicates"
msgstr "Slett alle %d duplikater"

#: admin/class-wp-ai-advisor-admin.php:403
msgid "Select all shown"
msgstr "Velg alle viste"

#: admin/class-wp-ai-advisor-admin.php:405 includes/class-wp-ai-advisor-page-context.php:103
msgid "Title"
msgstr "Tittel"

#: admin/class-wp-ai-advisor-admin.php:406
msgid "Type"
msgstr "Type"

#: admin/class-wp-ai-advisor-admin.php:408
msgid "Status"
msgstr "Status"

#: admin/class-wp-ai-advisor-admin.php:409
msgid "Updated"
msgstr "Oppdatert"

#: admin/class-wp-ai-advisor-admin.php:419
msgid "No sources with this status."
msgstr "Ingen kilder med denne statusen."

#: admin/class-wp-ai-advisor-admin.php:420
msgid "Nothing indexed yet."
msgstr "Ingenting er indeksert ennå."

#. translators: %s: comma-separated post type names.
#: admin/class-wp-ai-advisor-admin.php:503
msgid "Local mode: reads published %s from this install, with no HTTP requests. Re-run after you change content."
msgstr "Lokal modus: leser publiserte %s fra denne installasjonen, uten HTTP-forespørsler. Kjør på nytt når du endrer innhold."

#. translators: %s: comma-separated post type names.
#: admin/class-wp-ai-advisor-admin.php:504 admin/class-wp-ai-advisor-admin.php:512
msgid "(no post types selected)"
msgstr "(ingen innholdstyper er valgt)"

#. translators: 1: site URL, 2: comma-separated post type names.
#: admin/class-wp-ai-advisor-admin.php:510
msgid "Both modes: crawls %1$s for rendered navigation and reads published %2$s locally. Re-run after the site changes."
msgstr "Begge modi: gjennomsøker %1$s for ferdig vist navigasjon og leser publiserte %2$s lokalt. Kjør på nytt når nettstedet endres."

#. translators: %s: site URL being crawled.
#: admin/class-wp-ai-advisor-admin.php:518
msgid "Crawl mode: fetches %s, follows its internal links and stores the text. Re-run after the site changes."
msgstr "Gjennomsøkingsmodus: henter %s, følger interne lenker og lagrer teksten. Kjør på nytt når nettstedet endres."

#: admin/class-wp-ai-advisor-admin.php:532
msgid "Create a key at platform.openai.com. For production sites, define WP_AI_ADVISOR_API_KEY in wp-config.php instead of storing the key in the database."
msgstr "Opprett en nøkkel på platform.openai.com. På nettsteder i drift bør du definere WP_AI_ADVISOR_API_KEY i wp-config.php i stedet for å lagre nøkkelen i databasen."

#: admin/class-wp-ai-advisor-admin.php:592
msgid "is defined in wp-config.php and takes precedence over this field."
msgstr "er definert i wp-config.php og overstyrer dette feltet."

#: admin/class-wp-ai-advisor-admin.php:603
msgid "A key is saved. Enter a new key to replace it."
msgstr "En nøkkel er lagret. Skriv inn en ny nøkkel for å erstatte den."

#: admin/class-wp-ai-advisor-admin.php:606
msgid "Leave blank to keep the saved key."
msgstr "La feltet stå tomt for å beholde den lagrede nøkkelen."

#: admin/class-wp-ai-advisor-admin.php:616
msgid "Any chat model your account can use, for example gpt-4o-mini or gpt-4o."
msgstr "Enhver chat-modell kontoen din har tilgang til, for eksempel gpt-4o-mini eller gpt-4o."

#: admin/class-wp-ai-advisor-admin.php:626
msgid "Changing this invalidates the stored vectors — re-crawl afterwards."
msgstr "Endrer du denne, blir de lagrede vektorene ugyldige — bygg kunnskapsbasen på nytt etterpå."

#: admin/class-wp-ai-advisor-admin.php:636
msgid "Lower is more literal. 0.2 suits factual answers."
msgstr "Lavere verdi gir mer bokstavelige svar. 0,2 passer for faktasvar."

#: admin/class-wp-ai-advisor-admin.php:658
msgid "Crawl the site over HTTP"
msgstr "Gjennomsøk nettstedet over HTTP"

#: admin/class-wp-ai-advisor-admin.php:659
msgid "Sees the site exactly as a visitor does, including rendered navigation. Needs the site to be reachable from the server."
msgstr "Ser nettstedet nøyaktig slik en besøkende gjør, inkludert ferdig vist navigasjon. Krever at nettstedet er tilgjengelig fra serveren."

#: admin/class-wp-ai-advisor-admin.php:662
msgid "Read posts from this WordPress install"
msgstr "Les innlegg fra denne WordPress-installasjonen"

#: admin/class-wp-ai-advisor-admin.php:663
msgid "No HTTP requests and no page limit. Reaches unlinked pages a crawl would never find, but sees only post content, not theme-rendered menus."
msgstr "Ingen HTTP-forespørsler og ingen sidegrense. Finner sider uten lenker som en gjennomsøking aldri ville funnet, men ser bare innholdet i innlegg, ikke menyer som temaet genererer."

#: admin/class-wp-ai-advisor-admin.php:666
msgid "Both"
msgstr "Begge"

#: admin/class-wp-ai-advisor-admin.php:667
msgid "Crawl for navigation, local posts for completeness. Pages covered twice cost extra tokens to index and may return near-duplicate passages."
msgstr "Gjennomsøking for navigasjon, lokale innlegg for fullstendighet. Sider som dekkes to ganger koster ekstra tokens å indeksere og kan gi nesten like utdrag."

#: admin/class-wp-ai-advisor-admin.php:714
msgid "Only used in local mode. Published posts only; drafts, private and password-protected posts are skipped."
msgstr "Brukes bare i lokal modus. Kun publiserte innlegg; utkast, private og passordbeskyttede innlegg hoppes over."

#: admin/class-wp-ai-advisor-admin.php:724
msgid "Leave blank to crawl this site. Only used in crawl mode."
msgstr "La feltet stå tomt for å gjennomsøke dette nettstedet. Brukes bare i gjennomsøkingsmodus."

#: admin/class-wp-ai-advisor-admin.php:734
msgid "Caps how many pages a crawl fetches. Each page costs an embedding call."
msgstr "Begrenser hvor mange sider en gjennomsøking henter. Hver side koster et embedding-kall."

#: admin/class-wp-ai-advisor-admin.php:749
msgid "One fragment per line. Any URL containing one is skipped."
msgstr "Én tekstbit per linje. Alle nettadresser som inneholder en av dem, hoppes over."

#: admin/class-wp-ai-advisor-admin.php:762
msgid "Skip local posts whose URL the crawl already covered."
msgstr "Hopp over lokalt innhold med nettadresser gjennomsøkingen allerede har dekket."

#: admin/class-wp-ai-advisor-admin.php:765
msgid "Only affects both-modes. Without it the same page is indexed twice, which costs tokens and returns near-duplicate passages."
msgstr "Gjelder bare når begge modi er valgt. Uten denne blir samme side indeksert to ganger, noe som koster tokens og gir nesten like utdrag."

#: admin/class-wp-ai-advisor-admin.php:778
msgid "Run local content through the_content when importing."
msgstr "Kjør lokalt innhold gjennom the_content ved import."

#: admin/class-wp-ai-advisor-admin.php:781
msgid "Resolves shortcodes and page-builder markup the way the theme renders it. Turn it off if importing fails on a plugin or theme: blocks are still rendered, but shortcode output is dropped."
msgstr "Løser opp kortkoder og sidebygger-markup slik temaet viser det. Slå den av hvis importen feiler på en utvidelse eller et tema: blokker gjengis fortsatt, men innhold fra kortkoder faller bort."

#: admin/class-wp-ai-advisor-admin.php:794
msgid "Only answer from indexed site content and uploaded documents."
msgstr "Svar kun ut fra indeksert innhold fra nettstedet og opplastede dokumenter."

#: admin/class-wp-ai-advisor-admin.php:797
msgid "With this off, the model may also answer from general knowledge."
msgstr "Er denne slått av, kan modellen også svare ut fra generell kunnskap."

#: admin/class-wp-ai-advisor-admin.php:812
msgid "Shown when a question is outside the knowledge base. Leave blank for the default."
msgstr "Vises når et spørsmål faller utenfor kunnskapsbasen. La feltet stå tomt for standardteksten."

#: admin/class-wp-ai-advisor-admin.php:827
msgid "Sets tone and role. Grounding rules are appended automatically. Leave blank for the default."
msgstr "Angir tone og rolle. Regler for forankring legges til automatisk. La feltet stå tomt for standardteksten."

#: admin/class-wp-ai-advisor-admin.php:837
msgid "How many matching passages are sent with each question."
msgstr "Hvor mange treff som sendes med hvert spørsmål."

#: admin/class-wp-ai-advisor-admin.php:847
msgid "Passages scoring below this are ignored. Raise it if answers drift, lower it if the advisor refuses too often."
msgstr "Utdrag med lavere poengsum ignoreres. Øk verdien hvis svarene sklir ut, senk den hvis rådgiveren avviser for ofte."

#: admin/class-wp-ai-advisor-admin.php:858
msgid "Name of the custom field holding a price range as text, such as an ACF field. Read live from the page the visitor is on, so edits apply straight away. Leave blank to ignore it."
msgstr "Navnet på egendefinert felt som inneholder et prisintervall som tekst, for eksempel et ACF-felt. Leses direkte fra siden den besøkende er på, så endringer gjelder med én gang. La feltet stå tomt for å ignorere det."

#: admin/class-wp-ai-advisor-admin.php:865
msgid "Found:"
msgstr "Funnet:"

#: admin/class-wp-ai-advisor-admin.php:871
msgid "No published post carries a value in this field yet. Check the field name if you have already filled one in."
msgstr "Ingen publisert side har en verdi i dette feltet ennå. Sjekk feltnavnet hvis du allerede har fylt ut ett."

#. translators: 1: post title, 2: the field value found on it.
#: admin/class-wp-ai-advisor-admin.php:912
msgid "%1$s — \"%2$s\""
msgstr "%1$s — «%2$s»"

#: admin/class-wp-ai-advisor-admin.php:930
msgid "One per line. Shown instead of the usual suggestions when the widget sits on a product or post. Leave blank for the defaults."
msgstr "Ett per linje. Vises i stedet for de vanlige forslagene når modulen står på et produkt eller innlegg. La feltet stå tomt for standardverdiene."

#: admin/class-wp-ai-advisor-admin.php:943
msgid "Let the advisor answer \"what would this cost\" questions with a worked estimate."
msgstr "La rådgiveren svare på «hva vil dette koste»-spørsmål med et utregnet overslag."

#: admin/class-wp-ai-advisor-admin.php:946
msgid "Prices still have to come from your indexed content — the advisor may not invent one. Arithmetic is done by the plugin, not guessed by the model."
msgstr "Prisene må fortsatt komme fra det indekserte innholdet ditt — rådgiveren kan ikke finne på en pris. Regnestykket utføres av utvidelsen, ikke gjettet av modellen."

#: admin/class-wp-ai-advisor-admin.php:961
msgid "One per line. Figures the advisor may use when your content cannot supply them, such as cups per person per day. Every answer must say which numbers were assumptions. Leave blank for the defaults."
msgstr "Én per linje. Tall rådgiveren kan bruke når innholdet ditt ikke har dem, for eksempel kopper per person per dag. Hvert svar må si hvilke tall som var forutsetninger. La feltet stå tomt for standardverdiene."

#: admin/class-wp-ai-advisor-admin.php:973
msgid "Match the visitor (recommended)"
msgstr "Følg den besøkende (anbefalt)"

#: admin/class-wp-ai-advisor-admin.php:974
msgid "Always use the language of the page"
msgstr "Bruk alltid språket på siden"

#. translators: 1: language name, 2: language code.
#: admin/class-wp-ai-advisor-admin.php:979
msgid "Always %1$s (%2$s)"
msgstr "Alltid %1$s (%2$s)"

#. translators: %s: language name of the WordPress install.
#: admin/class-wp-ai-advisor-admin.php:998
msgid "This site runs in %s. On a translated site the widget reports the language of the page it sits on, which is what \"match the visitor\" falls back to."
msgstr "Dette nettstedet kjører på %s. På et oversatt nettsted rapporterer modulen språket til siden den står på, og det er dette «følg den besøkende» faller tilbake på."

#: admin/class-wp-ai-advisor-admin.php:1014
msgid "Show the widget to administrators only."
msgstr "Vis modulen kun for administratorer."

#: admin/class-wp-ai-advisor-admin.php:1017
msgid "Use this to test on a live site: visitors see nothing and the endpoint refuses them."
msgstr "Bruk denne for å teste på et nettsted i drift: besøkende ser ingenting, og endepunktet avviser dem."

#: admin/class-wp-ai-advisor-admin.php:1027
msgid "Per visitor, per hour. 0 disables the limit. Administrators are never limited."
msgstr "Per besøkende, per time. 0 slår av grensen. Administratorer begrenses aldri."

#: admin/class-wp-ai-advisor-admin.php:1037
msgid "Small label above the heading, e.g. \"Ask us\"."
msgstr "Liten etikett over overskriften, for eksempel «Spør oss»."

#: admin/class-wp-ai-advisor-admin.php:1070
msgid "One per line, up to six. Shown as buttons on the closed card."
msgstr "Ett per linje, opptil seks. Vises som knapper på det lukkede kortet."

#: admin/class-wp-ai-advisor-admin.php:1087
msgid "Label and URL for the highlighted button under each answer, e.g. \"Book a table\". Leave blank to hide it."
msgstr "Tekst og nettadresse for den fremhevede knappen under hvert svar, for eksempel «Bestill bord». La feltene stå tomme for å skjule den."

#: includes/class-wp-ai-advisor-calculator.php:83
msgid "The expression was empty."
msgstr "Uttrykket var tomt."

